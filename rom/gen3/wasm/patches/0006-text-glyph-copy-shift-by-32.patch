GLYPH_COPY shifts by 32 in two places: widthMask is (1 << 32) - 1 for a glyph column of 8
pixels, and pixels8 and mask8 shift right by 32 when the glyph starts on a tile's edge. The
GBA's register shifts give 0 for a count of 32; WebAssembly's i32.shl and i32.shr_u take the
count modulo 32. So in the WebAssembly build an 8-pixel column is masked away (the healthbox's
"Lv" glyph, 8 pixels wide, vanishes), and a glyph on a tile's edge is also drawn 8 pixels to its
right (the healthbox name's first letter over its third, a second gender sign). Under IRV_WASM
both shifts give what the GBA gives.

diff --git a/src/text.c b/src/text.c
--- a/src/text.c
+++ b/src/text.c
@@ -784,7 +784,12 @@
     if (width <= 0)
         return;
 
+#ifdef IRV_WASM
+    // A shift by 32 gives 0 on the GBA's ARM, but WebAssembly takes the count modulo 32.
+    u32 widthMask = width >= 8 ? 0xFFFFFFFF : (1u << (width * 4)) - 1;
+#else
     u32 widthMask = (1 << (width * 4)) - 1;
+#endif
 
     u32 shift0 = (x0 % 8) * 4, shift8 = 32 - shift0;
 
@@ -801,8 +806,14 @@
         mask = mask & 0x11111111;
         mask = mask * 0xF;
 
+#ifdef IRV_WASM
+        // At x0 % 8 == 0 shift8 is 32: nothing reaches the next tile, as on the GBA.
+        u32 pixels0 = pixels << shift0, pixels8 = shift0 == 0 ? 0 : pixels >> shift8;
+        u32 mask0 = mask << shift0, mask8 = shift0 == 0 ? 0 : mask >> shift8;
+#else
         u32 pixels0 = pixels << shift0, pixels8 = pixels >> shift8;
         u32 mask0 = mask << shift0, mask8 = mask >> shift8;
+#endif
 
         u32 *alignedWindowTiles = (u32 *)((u8 *)alignedWindowTilesX + ((y / 8) * widthOffset) + ((y % 8) * 4));
 
