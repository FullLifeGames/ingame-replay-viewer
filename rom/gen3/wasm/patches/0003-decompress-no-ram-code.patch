decompress.c copies its ARM decoders into a stack buffer and calls the buffer: the LZ77
decoder of decompress_asm.s, the tANS loops and the tile number decoder, each copied from
between two function addresses. WebAssembly runs no code from memory, and a function pointer
is a table index, so the copy would read between two indices and the call would trap. Under
IRV_WASM the buffer shrinks to one word, each wrapper gets the decoder itself, and LZ77 goes
to the BIOS call LZ77UnCompWram of our platform layer (layer/irv_bios.c).

diff --git a/src/decompress.c b/src/decompress.c
index 8030c72..8d333ff 100644
--- a/src/decompress.c
+++ b/src/decompress.c
@@ -398,15 +398,24 @@ static IWRAM_DATA u8 sBitIndex = 0;
 static IWRAM_DATA const u32 *sDataPtr = 0;
 static IWRAM_DATA u32 sCurrState = 0;
 
+#ifdef IRV_WASM
+// WebAssembly runs no code from RAM: a function pointer is a table index, so the decoder is called itself.
+#define FUNC_BUFFER_SIZE(funcStart, funcEnd) 1
+#define IWRAM_FUNC(funcBuffer, func) ((void *)(func))
+#else
 // 33 because of FastUnsafeCopy32, we divide by 4 because the buffer is an array of u32
 #define FUNC_BUFFER_SIZE(funcStart, funcEnd)(((u32)(funcEnd) - (u32)(funcStart) + 33) / 4)
+#define IWRAM_FUNC(funcBuffer, func) ((void *)(funcBuffer))
+#endif
 
 extern void FastUnsafeCopy32(void *, const void *, u32 size);
 
 //  Dark Egg magic
 static inline void CopyFuncToIwram(void *funcBuffer, const void *funcStartAddress, const void *funcEndAdress)
 {
+#ifndef IRV_WASM
     FastUnsafeCopy32(funcBuffer, funcStartAddress, funcEndAdress - funcStartAddress);
+#endif
 }
 
