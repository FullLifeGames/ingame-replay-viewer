The renderer reads VRAM through the port's VRAM_ array. With the one-to-one memory map
VRAM is the GBA address of the expansion's gba/defines.h, so VRAM_ becomes (u8 *)VRAM.

diff --git a/src/platform/gba_easy_draw.c b/src/platform/gba_easy_draw.c
index 289fec8..2759cf9 100644
--- a/src/platform/gba_easy_draw.c
+++ b/src/platform/gba_easy_draw.c
@@ -215,8 +215,8 @@ static void RenderRotScaleBGScanline(int bgNum, uint16_t control, uint16_t x, ui
     unsigned int screenBaseBlock = bgcnt->screenBaseBlock;
     unsigned int mapWidth = 1 << (4 + (bgcnt->screenSize)); // number of tiles
 
-    uint8_t *bgtiles = (uint8_t *)(VRAM_ + charBaseBlock * 0x4000);
-    uint8_t *bgmap = (uint8_t *)(VRAM_ + screenBaseBlock * 0x800);
+    uint8_t *bgtiles = (uint8_t *)((u8 *)VRAM + charBaseBlock * 0x4000);
+    uint8_t *bgmap = (uint8_t *)((u8 *)VRAM + screenBaseBlock * 0x800);
     uint16_t *pal = (uint16_t *)PLTT;
 
     if (control & BGCNT_MOSAIC)
@@ -456,7 +456,7 @@ static void DrawSprites(struct scanlineData* scanline, uint16_t vcount, bool win
     int i;
     unsigned int x;
     unsigned int y;
-    void *objtiles = VRAM_ + 0x10000;
+    void *objtiles = (u8 *)VRAM + 0x10000;
     unsigned int blendMode = (REG_BLDCNT >> 6) & 3;
     bool winShouldBlendPixel = true;
 
