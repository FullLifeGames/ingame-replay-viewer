{
  "name": "ingame-replay-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run knip && npm run test:coverage",
    "prepare": "lefthook install",
    "rom:build": "node scripts/rom-build.ts",
    "rom:check": "node scripts/rom-check.ts",
    "rom:clean": "node scripts/rom-build.ts --clean-only",
    "rom:repro": "node scripts/rom-repro.ts",
    "rom:shots": "node scripts/rom-shot.ts",
    "gen3:tables": "node scripts/gen3-tables.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "knip": "^6.47.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@pkmn/client": "^0.7.4",
    "@pkmn/data": "^0.11.0",
    "@pkmn/dex": "^0.11.0",
    "@pkmn/protocol": "^0.7.4",
    "@thenick775/mgba-wasm": "^2.6.0"
  }
}
